{
  "name": "forge-movement",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && cp dist/index.html dist/404.html",
    "preview": "vite preview",
    "deploy": "BASE_PATH=/forge-movement/ npm run build && gh-pages -d dist --dotfiles",
    "deploy:cf": "wrangler deploy",
    "momence:timetable": "node scripts/momence/parse-timetable.mjs",
    "momence:login": "node scripts/momence/create-classes.mjs --login",
    "momence:classes": "node scripts/momence/create-classes.mjs"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "gh-pages": "^6.3.0",
    "pdfjs-dist": "^4.10.38",
    "playwright": "^1.64.1",
    "vite": "^8.3.2",
    "wrangler": "^4.151.0"
  }
}
